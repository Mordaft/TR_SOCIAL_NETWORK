      {{#memberList}}
      <!-- USER PREVIEW -->
      <div class="user-preview">
        <!-- USER PREVIEW COVER -->
        <figure class="user-preview-cover liquid" style="background: url(&quot;{{background}}&quot;) center center / cover no-repeat;">
          <img src="{{background}}" alt="cover-{{background}}" style="display: none">
        </figure>
        <!-- /USER PREVIEW COVER -->
    
        <!-- USER PREVIEW INFO -->
        <div class="user-preview-info">
          <!-- USER SHORT DESCRIPTION -->
          <div class="user-short-description">
            <!-- USER SHORT DESCRIPTION AVATAR -->
            <div class="user-avatar-progress">
                <!-- HEXAGON -->
                <div class="hexagon-progress-100-110" style="width: 100px; height: 110px; position: relative;"><canvas width="100" height="110" style="position: absolute; top: 0px; left: 0px;"></canvas></div>
                <!-- /HEXAGON -->
            </div>


            <!-- /USER SHORT DESCRIPTION AVATAR -->
      
            <!-- USER SHORT DESCRIPTION TITLE -->
            <p class="user-short-description-title"><a href="profile-timeline" data-navigo>{{name}}</a></p>
            <!-- /USER SHORT DESCRIPTION TITLE -->
      
            <!-- USER SHORT DESCRIPTION TEXT -->
            <p class="user-short-description-text"><a href="#">{{full_name}}</a></p>
            <!-- /USER SHORT DESCRIPTION TEXT -->
          </div>
          <!-- /USER SHORT DESCRIPTION -->
      
          <!-- BADGE LIST -->
          <div class="badge-list small">
            <!-- BADGE ITEM -->
            <div class="badge-item">
              <img src="{{badge_1}}" alt="badge-silver-s">
            </div>
            <!-- /BADGE ITEM -->
      
            <!-- BADGE ITEM -->
            <div class="badge-item">
              <img src="{{badge_2}}" alt="badge-fcultivator-s">
            </div>
            <!-- /BADGE ITEM -->
      
            <!-- BADGE ITEM -->
            <div class="badge-item">
              <img src="{{badge_3}}" alt="badge-scientist-s">
            </div>
            <!-- /BADGE ITEM -->
      
            <!-- BADGE ITEM -->
            <div class="badge-item">
              <img src="{{badge_4}}" alt="badge-rmachine-s">
            </div>
            <!-- /BADGE ITEM -->
      
            <!-- BADGE ITEM -->
            <a class="badge-item" href="profile-badges" data-navigo>
              <img src="{{badge_5}}" alt="badge-blank-s">
              <!-- BADGE ITEM TEXT -->
              <p class="badge-item-text">{{total_badges}}</p>
              <!-- /BADGE ITEM TEXT -->
            </a>
            <!-- /BADGE ITEM -->
          </div>
          <!-- /BADGE LIST -->
    
          <!-- USER PREVIEW STATS SLIDES -->
          <div id="user-preview-stats-slides-01" class="user-preview-stats-slides">
            <!-- USER PREVIEW STATS SLIDE -->
            <div class="user-preview-stats-slide tns-item tns-slide-active">
              <div id="user-preview-stats-slides-01-mw" class="tns-ovh">
                <div class="tns-inner" id="user-preview-stats-slides-01-iw">
                  <!-- USER STATS -->
                  <div class="user-stats">
                    <!-- USER STAT -->
                    <div class="user-stat">
                      <!-- USER STAT TITLE -->
                      <p class="user-stat-title">{{posts}}</p>
                      <!-- /USER STAT TITLE -->
              
                      <!-- USER STAT TEXT -->
                      <p class="user-stat-text">posts</p>
                      <!-- /USER STAT TEXT -->
                    </div>
                    <!-- /USER STAT -->
              
                    <!-- USER STAT -->
                    <div class="user-stat">
                      <!-- USER STAT TITLE -->
                      <p class="user-stat-title">{{friends}}</p>
                      <!-- /USER STAT TITLE -->
              
                      <!-- USER STAT TEXT -->
                      <p class="user-stat-text">friends</p>
                      <!-- /USER STAT TEXT -->
                    </div>
                    <!-- /USER STAT -->
              
                    <!-- USER STAT -->
                    <div class="user-stat">
                      <!-- USER STAT TITLE -->
                      <p class="user-stat-title">{{visits}}</p>
                      <!-- /USER STAT TITLE -->
              
                      <!-- USER STAT TEXT -->
                      <p class="user-stat-text">visits</p>
                      <!-- /USER STAT TEXT -->
                    </div>
                    <!-- /USER STAT -->
                  </div>
                  <!-- /USER STATS -->
                </div>
              </div>
            </div>
            <!-- /USER PREVIEW STATS SLIDE -->
      
            <!-- USER PREVIEW STATS SLIDE -->
            <div class="user-preview-stats-slide tns-item hiddenScreen">
              <!-- USER PREVIEW TEXT -->
              <p class="user-preview-text">{{description}}</p>
              <!-- /USER PREVIEW TEXT -->
            </div>
            <!-- /USER PREVIEW STATS SLIDE -->
          </div>
          <!-- /USER PREVIEW STATS SLIDES -->
    
          <!-- USER PREVIEW STATS ROSTER -->
          <div id="user-preview-stats-roster-01" class="user-preview-stats-roster slider-roster">
            <!-- SLIDER ROSTER ITEM -->
            <div class="slider-roster-item"></div>
            <!-- /SLIDER ROSTER ITEM -->
    
            <!-- SLIDER ROSTER ITEM -->
            <div class="slider-roster-item"></div>
            <!-- /SLIDER ROSTER ITEM -->
          </div>
          <!-- /USER PREVIEW STATS ROSTER -->
    
          <!-- SOCIAL LINKS -->
          <div class="social-links small">
            <!-- SOCIAL LINK -->
            <a class="social-link small twitter" href="{{twitter}}">
              <!-- SOCIAL LINK ICON -->
              <svg class="social-link-icon icon-twitter">
                <use xlink:href="#svg-twitter"></use>
              </svg>
              <!-- /SOCIAL LINK ICON -->
            </a>
            <!-- /SOCIAL LINK -->

            <!-- SOCIAL LINK -->
            <a class="social-link small instagram" href="{{instagram}}">
              <!-- SOCIAL LINK ICON -->
              <svg class="social-link-icon icon-instagram">
                <use xlink:href="#svg-instagram"></use>
              </svg>
              <!-- /SOCIAL LINK ICON -->
            </a>
            <!-- /SOCIAL LINK -->

            <!-- SOCIAL LINK -->
            <a class="social-link small twitch" href="{{twitch}}">
              <!-- SOCIAL LINK ICON -->
              <svg class="social-link-icon icon-twitch">
                <use xlink:href="#svg-twitch"></use>
              </svg>
              <!-- /SOCIAL LINK ICON -->
            </a>
            <!-- /SOCIAL LINK -->

            <!-- SOCIAL LINK -->
            <a class="social-link small discord" href="{{discord}}">
              <!-- SOCIAL LINK ICON -->
              <svg class="social-link-icon icon-discord">
                <use xlink:href="#svg-discord"></use>
              </svg>
              <!-- /SOCIAL LINK ICON -->
            </a>
            <!-- /SOCIAL LINK -->
          </div>
          <!-- /SOCIAL LINKS -->
    
          <!-- USER PREVIEW ACTIONS -->
          <div class="user-preview-actions">
            <!-- BUTTON -->
            <p class="button secondary">Add Friend +</p>
            <!-- /BUTTON -->
    
            <!-- BUTTON -->
            <p class="button primary">Send Message</p>
            <!-- /BUTTON -->
          </div>
          <!-- /USER PREVIEW ACTIONS -->
        </div>
        <!-- /USER PREVIEW INFO -->
      </div>
      <!-- /USER PREVIEW -->
      {{/memberList}}